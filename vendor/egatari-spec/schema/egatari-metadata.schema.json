{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egatari.org/schema/egatari-metadata.schema.json",
  "title": "Egatari 1.0 metadata (index.metadata)",
  "type": "object",
  "required": [
    "title",
    "lang"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "maxLength": 64,
      "description": "BCP 47 language tag. This pattern approximates RFC 5646 (langtag / privateuse); readers SHOULD validate with a full BCP 47 parser.",
      "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+|[Ii]-[A-Za-z]+)$"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "accessMode": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessModeSufficient": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilityFeature": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilityHazard": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilitySummary": {
          "type": "string"
        }
      }
    },
    "curriculum": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "visitedFraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "reachedEnd": {
          "const": true
        }
      },
      "description": "Exactly one rule. Unknown future rules are preserved by editors; players that do not know the rule fall back to every-step-visited."
    },
    "derivedFrom": {
      "type": "object",
      "required": [
        "docId",
        "sourceSha256"
      ],
      "properties": {
        "docId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "anchor": {
          "type": "string",
          "pattern": "^.+:(0|[1-9][0-9]{0,2}|concl)$"
        }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "by"
        ],
        "properties": {
          "by": {
            "enum": [
              "human",
              "ai",
              "mixed"
            ]
          },
          "reviewed": {
            "type": "boolean"
          }
        }
      }
    },
    "audience": {
      "enum": [
        "public",
        "individual"
      ],
      "default": "public"
    },
    "copyright": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "created"
        ]
      },
      {
        "required": [
          "modified"
        ]
      },
      {
        "required": [
          "email"
        ]
      }
    ]
  }
}
