{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egatari.org/schema/deck-meta.schema.json",
  "title": "Egatari 1.0 runtime metadata (#deck-meta)",
  "type": "object",
  "required": [
    "format",
    "version",
    "contracts",
    "player",
    "generator",
    "docId",
    "title",
    "lang",
    "portable",
    "tracking"
  ],
  "properties": {
    "format": {
      "const": "egatari"
    },
    "version": {
      "$ref": "egatari-index.schema.json#/properties/version"
    },
    "contracts": {
      "$ref": "egatari-index.schema.json#/properties/contracts"
    },
    "player": {
      "$ref": "egatari-index.schema.json#/properties/player"
    },
    "generator": {
      "$ref": "egatari-index.schema.json#/properties/generator"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portable": {
      "type": "boolean"
    },
    "docId": {
      "$ref": "egatari-index.schema.json#/properties/docId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "$ref": "egatari-metadata.schema.json#/properties/lang"
    },
    "completion": {
      "$ref": "egatari-metadata.schema.json#/properties/completion"
    },
    "tracking": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "license": {
      "type": "string"
    },
    "copyright": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "offer": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "talk",
              "learn",
              "video"
            ]
          }
        },
        "faces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "talk",
              "read"
            ]
          }
        },
        "open": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "talk",
                "learn",
                "video"
              ]
            },
            "face": {
              "enum": [
                "talk",
                "read"
              ]
            }
          }
        }
      },
      "description": "Modes and faces the author offers, and where the lesson opens (§1.2). The author's intent, not access control."
    }
  },
  "if": {
    "properties": {
      "portable": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "sourceSha256"
    ]
  }
}
