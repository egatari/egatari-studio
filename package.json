{
  "name": "egatari",
  "version": "0.6.6-rc.1",
  "license": "MIT",
  "homepage": "https://studio.egatari.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egatari/egatari-studio.git"
  },
  "bugs": {
    "url": "https://github.com/egatari/egatari-studio/issues"
  },
  "type": "module",
  "bin": {
    "egatari": "bin/egatari.mjs"
  },
  "files": [
    "bin/",
    "kit/",
    "server/",
    "render/",
    "tts/*.py",
    "tts/pyproject.toml",
    "tts/uv.lock",
    "tts/.python-version",
    "tts/yomi.yaml",
    "tts/voices.json",
    "tts/voices/README.md",
    "themes/",
    "vendor/components/",
    "vendor/components-2/",
    "vendor/themes/",
    "vendor/egatari-spec/schema/",
    "vendor/csl/",
    "vendor/egatari-spec/LICENSE",
    "vendor/egatari-spec/SOURCE.json",
    "fonts/OFL.txt",
    "fonts/OFL-BIZUDPMincho.txt",
    "fonts/@fontsource/",
    "tools/new.mjs",
    "tools/ids.mjs",
    "tools/portable.mjs",
    "tools/sheet.mjs",
    "tools/comment-shots.mjs",
    "tools/video.mjs",
    "components.lock.json",
    "components2.lock.json",
    "themes.lock.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "!vendor/components/sha256/*/en.json",
    "!vendor/components/sha256/*/ja.json",
    "!**/.cache/",
    "!**/out/",
    "!**/__pycache__/"
  ],
  "scripts": {
    "build": "node kit/build.mjs",
    "dev": "node server/dev.mjs",
    "check": "node kit/check.mjs",
    "new": "node tools/new.mjs",
    "ids": "node tools/ids.mjs",
    "i18n": "node tools/i18n-pairs.mjs",
    "lint:terms": "node tools/lint-terms.mjs",
    "build:app": "node tools/build-app.mjs",
    "test": "node tools/test-all.mjs",
    "portable": "node tools/portable.mjs",
    "sheet": "node tools/sheet.mjs",
    "comment-shots": "node tools/comment-shots.mjs",
    "release:assets": "node tools/release-assets.mjs",
    "gen": "node tools/catalog.mjs && node tools/make-llm-guide.mjs && node tools/katex-ranges.mjs && node tools/make-colab-notebook.mjs",
    "gen:check": "node tools/components-update.mjs --check && node tools/themes-lock.mjs --check && node tools/fonts-vendor.mjs --check && node tools/catalog.mjs --check && node tools/make-llm-guide.mjs --check && node tools/part-labels-check.mjs && node tools/katex-ranges.mjs --check && node tools/changelog.mjs --check && node tools/make-colab-notebook.mjs --check && node tools/part-thumbs.mjs --check && node tools/parts-gallery.mjs --verify && node tools/build-book-tools.mjs --check",
    "thumbs": "node tools/part-thumbs.mjs",
    "changelog": "node tools/changelog.mjs",
    "components:update": "node tools/components-update.mjs",
    "components:check": "node tools/components-update.mjs --check",
    "themes:check": "node tools/themes-lock.mjs --check",
    "player:check": "node tools/player.mjs check",
    "player:bump": "node tools/player.mjs bump",
    "fonts:vendor": "node tools/fonts-vendor.mjs",
    "prepack": "node tools/fonts-vendor.mjs",
    "book-tools": "node tools/build-book-tools.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "abcjs": "6.7.2",
    "citeproc": "2.4.63",
    "katex": "0.19.1",
    "lame-wasm": "0.3.0",
    "parse5": "8.0.1",
    "playwright-core": "1.64.1"
  },
  "peerDependencies": {
    "@egatari/fonts-extra": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@egatari/fonts-extra": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/andika": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/biz-udpgothic": "5.3.0",
    "@fontsource/biz-udpmincho": "5.3.0",
    "@fontsource/klee-one": "5.3.1",
    "@fontsource/shippori-mincho": "5.3.0",
    "@fontsource/source-code-pro": "5.3.1",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@fontsource/zen-maru-gothic": "5.3.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "markdown-it": "14.3.3",
    "myst-ext-exercise": "1.0.10",
    "myst-ext-proof": "1.0.13",
    "myst-parser": "1.7.4",
    "myst-transforms": "1.3.51",
    "vfile": "6.0.3"
  },
  "overrides": {
    "linkify-it": "5.0.2",
    "csv-parse": "7.0.3",
    "katex": "0.19.1",
    "intersphinx": {
      "js-yaml": {
        "argparse": "3.0.3"
      }
    },
    "markdown-it": "14.3.3"
  }
}
