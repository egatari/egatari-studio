{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egatari.org/schema/egatari-metadata.schema.json",
  "title": "Egatari 1.0 metadata (index.metadata)",
  "type": "object",
  "required": [
    "title",
    "lang"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "maxLength": 64,
      "description": "BCP 47 language tag. This pattern approximates RFC 5646 (langtag / privateuse); readers SHOULD validate with a full BCP 47 parser.",
      "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+|[Ii]-[A-Za-z]+)$"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "accessMode": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessModeSufficient": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilityFeature": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilityHazard": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilitySummary": {
          "type": "string"
        }
      }
    },
    "curriculum": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "visitedFraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "reachedEnd": {
          "const": true
        },
        "played": {
          "const": true
        }
      },
      "description": "At most one of visitedFraction and reachedEnd, optionally with played (count only steps played on a stage, spec §9.2). Unknown future rules are preserved by editors; players that do not know the rule fall back to every-step-visited.",
      "not": {
        "required": [
          "visitedFraction",
          "reachedEnd"
        ]
      }
    },
    "derivedFrom": {
      "type": "object",
      "required": [
        "docId",
        "sourceSha256"
      ],
      "properties": {
        "docId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "anchor": {
          "type": "string",
          "pattern": "^.+:(0|[1-9][0-9]{0,2}|concl)$"
        }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "by"
        ],
        "properties": {
          "by": {
            "enum": [
              "human",
              "ai",
              "mixed"
            ]
          },
          "reviewed": {
            "type": "boolean"
          }
        }
      }
    },
    "audience": {
      "enum": [
        "public",
        "individual"
      ],
      "default": "public"
    },
    "copyright": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "importedFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mime",
          "sha256"
        ],
        "properties": {
          "mime": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "title": {
            "type": "string"
          },
          "attachment": {
            "type": "string",
            "pattern": "^attachments/"
          }
        }
      }
    },
    "primary": {
      "enum": [
        "talk",
        "read"
      ],
      "default": "talk"
    },
    "offer": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "talk",
              "learn",
              "video"
            ]
          }
        },
        "faces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "talk",
              "read"
            ]
          }
        },
        "open": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "talk",
                "learn",
                "video"
              ]
            },
            "face": {
              "enum": [
                "talk",
                "read"
              ]
            }
          }
        }
      },
      "description": "Modes and faces the author offers, and where the lesson opens (§1.2). The author's intent, not access control."
    },
    "series": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "part": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The series the lesson belongs to (spec §9C.1A)."
    },
    "citations": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "list": {
          "enum": [
            "end",
            "chapter",
            "none"
          ]
        },
        "placement": {
          "enum": [
            "inline",
            "footer",
            "both"
          ]
        }
      },
      "description": "Citation presentation (spec §9C.4). placement is reserved (Appendix A, issue 7)."
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "created"
        ]
      },
      {
        "required": [
          "modified"
        ]
      },
      {
        "required": [
          "email"
        ]
      }
    ]
  }
}
